{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SweaxDrop",
  "version": "1.0.0",
  "identifier": "com.sweaxstudios.sweaxdrop",
  "build": {
    "frontendDist": "../../../ui/dist",
    "beforeBuildCommand": "",
    "beforeDevCommand": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SweaxDrop",
        "width": 1080,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "decorations": false,
        "visible": false,
        "center": true,
        "dragDropEnabled": true,
        "backgroundColor": "#0c0e12"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Sweax Studios",
    "copyright": "© 2026 Sweax Studios",
    "category": "Utility",
    "shortDescription": "Send files between your PC and your phones, fast.",
    "longDescription": "SweaxDrop moves files, photos, folders and text between Windows, Android and iPhone over your own network, encrypted end to end.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": ["English", "Turkish"],
        "installerHooks": "windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true }
    }
  }
}
